# A Netease-compatible API, normally kept private.
NCM_API_BASE_URL=http://127.0.0.1:3939

# External base URL of this service's audio proxy.
PUBLIC_BASE_URL=https://your-domain.example/music-audio

# Optional absolute path to a local cookie file. Do not commit that file.
NCM_COOKIE_FILE=/run/secrets/music_cookie.txt

MCP_HOST=127.0.0.1
MCP_PORT=3941
PROXY_HOST=127.0.0.1
PROXY_PORT=3942
ALLOWED_AUDIO_HOST_SUFFIXES=.music.126.net
