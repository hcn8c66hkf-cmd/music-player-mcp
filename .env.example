# A Netease-compatible API, normally kept private.
NCM_API_BASE_URL=http://127.0.0.1:3939

# External origin of this service. The MCP endpoint is PUBLIC_BASE_URL/mcp.
PUBLIC_BASE_URL=https://music.example.com

# Optional absolute path to a local cookie file. Do not commit that file.
NCM_COOKIE_FILE=/run/secrets/music_cookie.txt

APP_HOST=127.0.0.1
APP_PORT=3941
MUSIC_STATE_PATH=./data/music_state.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MUSIC_EVENT_SIGNING_SECRET=replace-with-a-long-random-value
MUSIC_ACTIVE_LEASE_SECONDS=7200
MUSIC_EVENT_TOKEN_TTL_SECONDS=86400
ALLOWED_AUDIO_HOST_SUFFIXES=.music.126.net
